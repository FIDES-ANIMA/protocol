{
  "name": "@fides-anima/fpp-tool-proxy",
  "version": "0.1.0",
  "description": "Shared MCP/sidecar tool proxy for FPP enforcement-core",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE",
    "constitution.json",
    "constitution.yaml",
    "SKILL.md"
  ],
  "bundledDependencies": [
    "@fides-anima/fpp-protocol-core",
    "@fides-anima/fpp-enforcement-core",
    "@fides-anima/fpp-steward-auth-core"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle:deps": "npx tsx ../../scripts/bundle-workspace-deps.ts --package packages/tool-proxy",
    "prepack": "npm run build && npm run bundle:deps",
    "typecheck": "tsc -p tsconfig.json --noEmit --declaration false --declarationMap false",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@noble/ed25519": "^2.1.0",
    "@noble/hashes": "^1.4.0",
    "@fides-anima/fpp-enforcement-core": "1.0.3",
    "@fides-anima/fpp-protocol-core": "1.0.3",
    "@sinclair/typebox": "^0.34.0",
    "@fides-anima/fpp-steward-auth-core": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=22.19"
  },
  "author": "ovrsr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FIDES-ANIMA/protocol.git",
    "directory": "packages/tool-proxy"
  },
  "homepage": "https://github.com/FIDES-ANIMA/protocol#readme",
  "bugs": {
    "url": "https://github.com/FIDES-ANIMA/protocol/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
